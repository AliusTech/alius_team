{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Alius",
  "version": "0.1.0",
  "identifier": "tech.alius.team-client",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Alius",
        "width": 1280,
        "height": 800,
        "minWidth": 768,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["msi", "dmg", "app", "deb", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Alius - Agent Management Client",
    "longDescription": "Cross-platform Agent management client for managing, observing and controlling Alius platform Agent nodes and task execution status",
    "windows": {
      "wix": {
        "language": "en-US"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.13",
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    },
    "iOS": {
      "minimumSystemVersion": "18.0"
    },
    "android": {
      "minSdkVersion": 24
    }
  },
  "plugins": {
    "opener": {
      "open": true
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE5QjBFMDRCQTYyQ0E1NUMKUldSY3BTeW1TK0N3cWJuSG9raUtSVFhJTkNVZGlnOTJ4T1c3RXRyYnJuQ0hmTnRoNFRSbHFBdVUK",
      "endpoints": [
        "https://github.com/AliusTech/alius_team/releases/latest/download/latest.json"
      ]
    }
  }
}